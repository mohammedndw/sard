# Firebase Configuration
# Set NEXT_PUBLIC_FIREBASE_API_KEY to your actual Firebase API key
# Or set NEXT_PUBLIC_USE_EMULATORS=true to use Firebase emulators for development

# Option 1: Use Firebase Emulators (for local development)
NEXT_PUBLIC_USE_EMULATORS=true

# Option 2: Use actual Firebase API key (for production)
# NEXT_PUBLIC_FIREBASE_API_KEY=your_actual_firebase_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=sard-283cc
