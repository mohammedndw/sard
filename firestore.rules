rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function to check if incoming data has userId matching auth
    function incomingUserIdMatches() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    // Helper function to check role is not being changed
    function roleNotChanged() {
      return !('role' in request.resource.data) || 
             request.resource.data.role == resource.data.role;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can update their own profile but not their role; admins can update anything
      allow update: if isAdmin() || (isOwner(userId) && roleNotChanged());
      allow delete: if isAdmin();
    }
    
    // Events collection - public read, admin write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      // Tickets subcollection
      match /tickets/{ticketId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    
    // Registrations collection
    match /registrations/{registrationId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Users can only create registrations for themselves
      allow create: if isAuthenticated() && incomingUserIdMatches();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Bookings collection (place rental requests)
    match /bookings/{bookingId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.email == request.auth.token.email);
      // Anyone can create booking requests (email-based, not userId based)
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Payments should only be created by authenticated users for themselves
      allow create: if isAuthenticated() && incomingUserIdMatches();
      allow update: if isAdmin();
      allow delete: if false;
    }
    
    // Contacts collection (existing contact form - public create)
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
